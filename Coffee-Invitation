<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Coffee?</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #f7f2ec;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Tahoma, Arial, sans-serif;
      color: #2f2925;
      overflow: hidden;
    }

    .card {
      width: min(90%, 520px);
      padding: 38px 28px;
      background: rgba(255,255,255,.82);
      border-radius: 28px;
      box-shadow: 0 18px 50px rgba(60,45,35,.12);
      text-align: center;
      position: relative;
    }

    .heart {
      font-size: 38px;
      margin-bottom: 15px;
    }

    .message {
      font-size: 19px;
      line-height: 2;
      white-space: pre-line;
      margin: 0;
    }

    .question {
      margin-top: 25px;
      font-size: 22px;
      font-weight: 700;
    }

    .buttons {
      margin-top: 25px;
      min-height: 58px;
      position: relative;
      display: flex;
      justify-content: center;
      gap: 14px;
    }

    button {
      border: 0;
      border-radius: 999px;
      padding: 14px 30px;
      font-size: 17px;
      cursor: pointer;
      transition: .25s ease;
      font-weight: 700;
    }

    #yesBtn {
      background: #2f2925;
      color: #fff;
    }

    #yesBtn:hover {
      transform: scale(1.05);
    }

    #noBtn {
      background: #eee7df;
      color: #2f2925;
      z-index: 5;
    }

    .result {
      display: none;
      font-size: 20px;
      line-height: 2;
      white-space: pre-line;
    }

    .coffee {
      font-size: 48px;
      margin-bottom: 15px;
    }

    .it-note {
      display: none;
      margin-top: 18px;
      font-size: 14px;
      opacity: .72;
    }
  </style>
</head>

<body>

  <main class="card" id="card">

    <div id="invite">

      <div class="heart">♥️</div>

      <p class="message">طوّلناها كثير …
انا مو حاب ان آخر شئ بيننا يكون بالطريقة ذي ♥️ .
ومن جوآك تقلين نفس كلامي .

إذا ودك نتكلم بهدوء ونفهم بعض ، بعيد عن الزعل والمكابرة …
انا قريب ..</p>

      <div class="question">
        قهوة؟ ☕️
      </div>

      <div class="buttons" id="buttons">

        <button id="yesBtn">
          YES
        </button>

        <button id="noBtn">
          NO
        </button>

      </div>

      <div class="it-note" id="itNote">
        IT guy… كان لازم أتأكد إن زر NO فيه مشكلة تقنية 😌
      </div>

    </div>


    <div class="result" id="result">

      <div class="coffee">
        ☕️🤍
      </div>

      اتفقنا Aşkım ❤️
      هالمرة نترك الزعل والمكابرة وراءنا،
      والباقي نقوله على القهوة ☕️🤍
      وأنتظر منك تحددين الوقت الي يناسبك

    </div>

  </main>


  <script>

    const yesBtn = document.getElementById('yesBtn');
    const noBtn = document.getElementById('noBtn');

    const invite = document.getElementById('invite');
    const result = document.getElementById('result');

    const itNote = document.getElementById('itNote');

    let noAttempts = 0;


    yesBtn.addEventListener('click', () => {

      invite.style.display = 'none';

      result.style.display = 'block';

    });


    function moveNo() {

      noAttempts++;

      if (noAttempts <= 2) {

        noBtn.style.position = 'fixed';

        const padding = 20;

        const maxX =
          Math.max(
            padding,
            window.innerWidth - noBtn.offsetWidth - padding
          );

        const maxY =
          Math.max(
            padding,
            window.innerHeight - noBtn.offsetHeight - padding
          );

        const x =
          padding +
          Math.random() * (maxX - padding);

        const y =
          padding +
          Math.random() * (maxY - padding);


        noBtn.style.left = `${x}px`;

        noBtn.style.top = `${y}px`;

      }

      else {

        noBtn.style.display = 'none';

        itNote.style.display = 'block';

      }

    }


    noBtn.addEventListener(
      'click',
      moveNo
    );

  </script>

</body>
</html>
